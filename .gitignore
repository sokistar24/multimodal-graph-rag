# Secrets
.env

# Built corpora and downloads (regenerated by `rag ingest`)
publaynet_corpus/
publaynet_images/
spiqa_corpus/
spiqa_download/
spiqa_images/*.png
spiqa_images/*.jpg
hotpotqa_corpus/
docbank_corpus/
docbank_images/
doclaynet_corpus/
doclaynet_images/

# Retrieval caches
.cache/

# Run outputs: only frozen, manifest-listed runs are committed under artifacts/runs/release/
artifacts/runs/*
!artifacts/runs/legacy/
!artifacts/runs/release/
artifacts/tables/*
!artifacts/tables/legacy/
artifacts/figures/*
!artifacts/figures/legacy/
# Runtime logs at the repository root only; archive/logs/ is kept for provenance.
/logs/

# Python and tooling
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv-cache/
.uv-python/
*.egg-info/
build/
dist/

# Editors and scratch
.vscode/
tmp/

# Write-up sources and their build products are kept outside this repository.
paper/
