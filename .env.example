# Provider keys are read only when a command that calls that provider starts.
# Add the keys a run needs; every other line can stay empty.
OPENAI_API_KEY=            # generators gpt4o-mini/gpt4o, embeddings, captioning, triple extraction
GEMINI_API_KEY=            # generator gemini-flash-lite (OpenAI-compatible endpoint)
DEEPINFRA_API_KEY=         # generators llama4-maverick, llama4-scout
DEEPSEEK_API_KEY=          # text judge and text question author
ANTHROPIC_API_KEY=         # figure question author (claude-haiku)
OPENROUTER_API_KEY=        # 2026-09-10 roster: qwen3.7-flash generator; claude-sonnet-5, claude-opus-5, deepseek-v4-pro, grok-4.3 judges
HF_TOKEN=                  # optional: Hugging Face downloads for SPIQA/HotpotQA/DocLayNet
TESSERACT_CMD=             # optional: full path to tesseract.exe when it is not on PATH
