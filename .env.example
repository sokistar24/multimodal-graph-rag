# Provider keys are read only when a command that calls that provider starts.
# Every generator, judge, and embedding model is served through OpenRouter
# (adopted 2026-10-20), so a run needs only this key.
OPENROUTER_API_KEY=        # all models: generators, judges, authors, embeddings
HF_TOKEN=                  # optional: Hugging Face downloads for SPIQA/HotpotQA/DocLayNet
TESSERACT_CMD=             # optional: full path to tesseract.exe when it is not on PATH
